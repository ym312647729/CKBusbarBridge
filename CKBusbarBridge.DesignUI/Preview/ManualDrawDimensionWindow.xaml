<rd:RDDialogWindow x:Class="CKBusbarBridge.DesignPreview.ManualDrawDimensionWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:rd="clr-namespace:RD.UI.Wpf.Controls;assembly=RD.UI.Wpf"
                   xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                   Title="修改尺寸" WindowKey="CKBusbarBridge.DimensionInput"
                   Width="248" MinWidth="248" MaxWidth="248"
                   SizeToContent="Height" MinHeight="0" MaxHeight="240" ResizeMode="NoResize"
                   IsPlacementPersistenceEnabled="False"
                   Padding="8,8,8,0" FooterPadding="8,4" Background="White" FooterBackground="White"
                   WindowStartupLocation="Manual" ShowInTaskbar="False"
                   Loaded="OnWindowLoaded" Closed="OnWindowClosed"
                   PreviewKeyDown="OnEditorKeyDown" PreviewMouseWheel="OnEditorMouseWheel">
    <!-- 小型无边框弹框不使用DWM玻璃边，避免OpenGL宿主下出现未绘制的黑色客户区。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <rd:RDDialogWindow.Resources>
        <ResourceDictionary Source="WpfLibraryAppearance.xaml" />
    </rd:RDDialogWindow.Resources>
    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DimensionName" MaxWidth="80" Margin="0,0,8,0" VerticalAlignment="Center"
                       Style="{StaticResource RDText.Body}" TextTrimming="CharacterEllipsis" />
            <rd:RDInput x:Name="ValueInput" Grid.Column="1" TextChanged="OnValueChanged" />
        </Grid>
        <!-- 窄幅金属细齿滚轮；透明区域扩大操作范围，拖动仍可持续旋转。 -->
        <Border x:Name="AdjustmentWheel" Height="24" Margin="0,4,0,0" ClipToBounds="True"
                Background="Transparent" Cursor="ScrollWE" Focusable="False"
                ToolTip="滚动鼠标或左右拖动，每格0.1 mm；向右增加，向左减少"
                MouseLeftButtonDown="OnWheelPressed" MouseMove="OnWheelMoved"
                MouseLeftButtonUp="OnWheelReleased" LostMouseCapture="OnWheelCaptureLost">
            <Border Height="16" VerticalAlignment="Center" BorderThickness="1" CornerRadius="1"
                    Padding="1" Background="#404040" IsHitTestVisible="False"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#707070" Offset="0" />
                        <GradientStop Color="#424242" Offset="0.55" />
                        <GradientStop Color="#F4F4F4" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid ClipToBounds="True">
                    <!-- 齿面用成对明暗面表现倒角；4px周期与现有8px旋转回绕一致。 -->
                    <Rectangle Margin="-8,0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="WheelRotation" /></Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,4,12" ViewportUnits="Absolute"
                                          Viewbox="0,0,4,12" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M0,0 H4 V12 H0 Z">
                                        <GeometryDrawing.Brush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#555555" Offset="0" />
                                                <GradientStop Color="#929292" Offset="0.12" />
                                                <GradientStop Color="#FAFAFA" Offset="0.25" />
                                                <GradientStop Color="#E7E7E7" Offset="0.62" />
                                                <GradientStop Color="#B5B5B5" Offset="0.76" />
                                                <GradientStop Color="#666666" Offset="1" />
                                            </LinearGradientBrush>
                                        </GeometryDrawing.Brush>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 圆柱高光与上下暗部保持不动，只有细齿随拖动平移。 -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#90202020" Offset="0" />
                                <GradientStop Color="#20303030" Offset="0.15" />
                                <GradientStop Color="#40FFFFFF" Offset="0.35" />
                                <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="0.65" />
                                <GradientStop Color="#40303030" Offset="0.85" />
                                <GradientStop Color="#A0202020" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 两侧用宽幅渐暗表现滚轮转入凹槽的曲面，不随齿纹平移。 -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E0181818" Offset="0" />
                                <GradientStop Color="#B0282828" Offset="0.025" />
                                <GradientStop Color="#80333333" Offset="0.08" />
                                <GradientStop Color="#40393939" Offset="0.16" />
                                <GradientStop Color="#0C393939" Offset="0.28" />
                                <GradientStop Color="#00393939" Offset="0.4" />
                                <GradientStop Color="#00393939" Offset="0.6" />
                                <GradientStop Color="#0C393939" Offset="0.72" />
                                <GradientStop Color="#40393939" Offset="0.84" />
                                <GradientStop Color="#80333333" Offset="0.92" />
                                <GradientStop Color="#B0282828" Offset="0.975" />
                                <GradientStop Color="#E0181818" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border Background="#20FFFFFF">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=AdjustmentWheel}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseCaptured, ElementName=AdjustmentWheel}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
        </Border>
        <TextBlock x:Name="ErrorText" Margin="0,4,0,0" Style="{StaticResource RDText.Error}"
                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
    </StackPanel>
    <rd:RDDialogWindow.FooterContent>
        <StackPanel Orientation="Horizontal">
            <rd:RDButton Content="取消" Variant="Secondary" IsCancel="True" MinWidth="64"
                         Margin="0,0,8,0" Click="OnCancel" />
            <rd:RDButton Content="确定" Variant="Primary" IsDefault="True" MinWidth="64" Click="OnConfirm" />
        </StackPanel>
    </rd:RDDialogWindow.FooterContent>
</rd:RDDialogWindow>
