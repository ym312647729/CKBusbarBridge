<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CopyCKPreviewAlgorithmWorker" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Copy-PublishedWorker.ps1&quot; -PackageDirectory &quot;$(MSBuildProjectDirectory)\AlgorithmWorkerDelivery&quot; -OutputDirectory &quot;$(TargetDir)AlgorithmWorker&quot;" UseUtf8Encoding="Always" />
  </Target>
</Project>
