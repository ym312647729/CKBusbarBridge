<Window Style="{DynamicResource SmallCornerWindowStyle}" x:Class="CKBusbarBridge.views.FrameDriverWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CKBusbarBridge.views"
 Title="川开母线桥设计（试用）" Width="1520" Height="850" MinWidth="880" MinHeight="580"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei" FontSize="12" Background="#F0F4F8"
 Closing="Window_Closing" Closed="Window_Closed">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CKBusbarBridge.DesignUI;component/views/SmallCornerWindowResources.xaml" />
    <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
    <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="FrameSelectionVisibility"/>
   <local:BridgeObjectListValueConverter x:Key="ObjectListValueConverter"/>
   <SolidColorBrush x:Key="BridgeSurfaceBrush" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="BridgeIssueBrush" Color="#E1251B"/>
   <SolidColorBrush x:Key="BridgePreviewBackgroundBrush" Color="{x:Static local:BusbarBridgeJointPreviewControl.PreviewBackgroundColor}"/>
   <SolidColorBrush x:Key="BridgePanelBorderBrush" Color="#B9C4D2"/>
   <SolidColorBrush x:Key="BridgeToolbarBorderBrush" Color="#D5DFEA"/>
   <SolidColorBrush x:Key="BridgeGridBorderBrush" Color="#9EACBD"/>
   <SolidColorBrush x:Key="BridgeGridHeadingBrush" Color="#EAF0F6"/>
   <SolidColorBrush x:Key="BridgeMutedBrush" Color="#50667F"/>
   <SolidColorBrush x:Key="BridgeSelectedBrush" Color="#E8F1FF"/>

   <!-- 沿用通用控件交互，设计页采用原型的紧凑尺寸和蓝灰细边。 -->
   <Style x:Key="BridgeButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
    <Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="2,1"/><Setter Property="MinHeight" Value="26"/>
    <Setter Property="Background" Value="{StaticResource BridgeSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="#C9D6E6"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   </Style>
   <Style TargetType="Button" BasedOn="{StaticResource BridgeButtonStyle}"/>
   <Style x:Key="BridgeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
    <Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,1"/>
    <Setter Property="BorderBrush" Value="#C9D6E6"/>
   </Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource BridgeTextBoxStyle}"/>
   <Style x:Key="BridgeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
    <Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="2,1"/>
    <Setter Property="BorderBrush" Value="#C9D6E6"/>
   </Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource BridgeComboBoxStyle}"/>
   <Style x:Key="BridgeCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource BridgeCheckBoxStyle}"/>
   <Style x:Key="BridgeObjectRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <EventSetter Event="RequestBringIntoView" Handler="ObjectRow_RequestBringIntoView"/>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F6FF"/></Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="{StaticResource BridgeSelectedBrush}"/><Setter Property="Foreground" Value="#17365D"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <!-- 主题的选中单元格使用白字，必须同时覆盖单元格和行，避免白底白字。 -->
   <Style x:Key="BridgeObjectCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Style.Triggers>
     <Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="{StaticResource BridgeSelectedBrush}"/><Setter Property="Foreground" Value="#17365D"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="BridgeFirstCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BridgeObjectCellStyle}">
    <Style.Triggers>
     <Trigger Property="IsSelected" Value="True">
      <Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="#2672C7"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="BridgeColumnHeaderStyle" TargetType="DataGridColumnHeader"
          BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="Background" Value="{StaticResource BridgeGridHeadingBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource BridgeMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BridgePanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="7,0"/><Setter Property="FontWeight" Value="Normal"/>
   </Style>
   <Style x:Key="BridgeNumericColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BridgeColumnHeaderStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
   </Style>
   <Style x:Key="BridgeCopperNumericColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BridgeNumericColumnHeader}">
    <Setter Property="Padding" Value="4,0,5,0"/>
   </Style>
   <Style x:Key="BridgeNumericCellText" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="5,0,7,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <Style x:Key="BridgeListCellText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <Style x:Key="BridgeSequenceCellText" TargetType="TextBlock" BasedOn="{StaticResource BridgeListCellText}">
    <Setter Property="Foreground" Value="{StaticResource BridgeMutedBrush}"/>
    <Setter Property="Margin" Value="3,0"/><Setter Property="TextTrimming" Value="None"/>
   </Style>
   <Style x:Key="BridgeDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource DataGridBaseStyle}">
    <Setter Property="RowStyle" Value="{StaticResource BridgeObjectRowStyle}"/>
    <Setter Property="CellStyle" Value="{StaticResource BridgeObjectCellStyle}"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource BridgeColumnHeaderStyle}"/>
    <Setter Property="Background" Value="{StaticResource BridgeSurfaceBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="RowBackground" Value="{StaticResource BridgeSurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="#F6F8FB"/>
    <Setter Property="GridLinesVisibility" Value="All"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BridgePanelBorderBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BridgePanelBorderBrush}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <EventSetter Event="PreviewMouseWheel" Handler="ObjectGrid_PreviewMouseWheel"/>
    <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="28"/>
    <Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="BorderBrush" Value="{StaticResource BridgeGridBorderBrush}"/>
   </Style>
   <Style TargetType="DataGrid" BasedOn="{StaticResource BridgeDataGridStyle}"/>
   <Style x:Key="BridgeTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource TabControlInLine}">
    <Setter Property="Background" Value="{StaticResource BridgeSurfaceBrush}"/><Setter Property="BorderThickness" Value="0"/>
   </Style>
   <Style TargetType="TabControl" BasedOn="{StaticResource BridgeTabControlStyle}"/>
   <Style TargetType="TabItem" BasedOn="{StaticResource TabItemInLine}"><Setter Property="Padding" Value="10,5"/></Style>
   <Style x:Key="BridgeObjectContentStyle" TargetType="TabControl" BasedOn="{StaticResource BridgeTabControlStyle}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </ControlTemplate></Setter.Value></Setter>
   </Style>

   <Style x:Key="BridgeCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BridgeSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BridgePanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   </Style>
   <Style x:Key="BridgeToolbarBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BridgeSurfaceBrush}"/><Setter Property="Padding" Value="2"/>
    <Setter Property="BorderBrush" Value="{StaticResource BridgeToolbarBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   </Style>
   <Style x:Key="BridgeListHeadingBar" TargetType="Border" BasedOn="{StaticResource BridgeToolbarBorderStyle}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
   </Style>
   <Style x:Key="BridgeListContext" TargetType="TextBlock">
    <Setter Property="Margin" Value="1,5,1,6"/><Setter Property="Foreground" Value="{StaticResource BridgeMutedBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <Style x:Key="BridgePanelHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="BridgePreviewViewFrame" TargetType="Border" BasedOn="{StaticResource BridgeCardStyle}">
    <Setter Property="BorderBrush" Value="{StaticResource BridgeToolbarBorderBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
   </Style>
   <Style x:Key="BridgePreviewViewHeading" TargetType="Border" BasedOn="{StaticResource BridgeToolbarBorderStyle}">
    <Setter Property="Padding" Value="8,5"/>
   </Style>
   <Style x:Key="BridgeSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Background" Value="#BCC9D8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
     <Grid Background="Transparent">
      <Border x:Name="Grip" Width="3" Height="32" CornerRadius="1" Background="{TemplateBinding Background}"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="ResizeDirection" Value="Rows">
       <Setter TargetName="Grip" Property="Width" Value="32"/><Setter TargetName="Grip" Property="Height" Value="3"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#6A91C0"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="BridgeDetailsStyle" TargetType="Expander">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
     <DockPanel>
      <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" MinHeight="30" HorizontalAlignment="Stretch" Content="{TemplateBinding Header}"
                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="DetailsHeader" Background="#F6F8FB" BorderBrush="{StaticResource BridgePanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
         <DockPanel>
          <Path x:Name="Arrow" DockPanel.Dock="Right" Width="9" Height="5" Stroke="{StaticResource BridgeMutedBrush}"
                Stretch="Fill" Data="M 0,0 L 4,4 L 8,0" VerticalAlignment="Center" Margin="10,0,1,0"/>
          <ContentPresenter VerticalAlignment="Center"/>
         </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DetailsHeader" Property="Background" Value="#EAF2FC"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DetailsHeader" Property="Background" Value="#EAF2FC"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="ObjectDetails" Margin="10,3,10,7" Visibility="Collapsed"/>
     </DockPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ObjectDetails" Property="Visibility" Value="Visible"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>

   <!-- 带事件的模板独立声明，Style仅引用资源，避免MC4007事件连接限制。 -->
   <DataTemplate x:Key="BridgeNumericFieldTemplate">
    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
     KeyDown="Field_KeyDown" LostKeyboardFocus="Field_LostKeyboardFocus" ToolTip="Enter/失焦提交，Esc取消；定位为距基架模型起始端的距离，小数使用点。">
     <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource BridgeTextBoxStyle}"><Style.Triggers>
      <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
       <Setter Property="IsEnabled" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
       <Setter Property="Background" Value="#F5F5F5"/><Setter Property="Foreground" Value="#8C8C8C"/><Setter Property="BorderBrush" Value="#D9D9D9"/>
      </DataTrigger>
     </Style.Triggers></Style></TextBox.Style>
    </TextBox>
   </DataTemplate>
   <DataTemplate x:Key="BridgeChoiceFieldTemplate">
    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
     SelectionChanged="FieldChoice_SelectionChanged" KeyDown="Field_KeyDown" LostKeyboardFocus="Field_LostKeyboardFocus">
     <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BridgeComboBoxStyle}"><Style.Triggers>
      <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/></DataTrigger>
     </Style.Triggers></Style></ComboBox.Style>
    </ComboBox>
   </DataTemplate>
   <!-- 仅实物编辑模式加载二维预览。 -->
   <DataTemplate x:Key="PhysicalPreviewTemplate">
  <Grid x:Name="PreviewPane" Grid.RowSpan="3" Grid.Column="0" IsEnabled="{Binding IsEditingEnabled}">
   <Border Style="{StaticResource BridgeCardStyle}" ClipToBounds="True"><DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource BridgeToolbarBorderStyle}" MinHeight="36" Padding="8,3"><DockPanel>
     <TextBlock DockPanel.Dock="Left" Text="二维预览" Style="{StaticResource BridgePanelHeading}" Margin="0,0,6,0"/>
     <Button x:Name="DetachPreviewButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="拖出窗口 ↗" ToolTip="在独立窗口同时显示前视和俯视" Click="DetachPreview_Click"/>
     <WrapPanel HorizontalAlignment="Right">
     <Button Content="适应全部" Click="FitAll_Click"/><Button Content="定位选中" Click="FitSelected_Click"/>
     <Button Content="3D预览" IsEnabled="{Binding CanNativePreview}" Click="Preview3D_Click" ToolTip="在SolidWorks总装中显示完整草稿：铜排、基架及绝缘子；仅显示临时实体"/>
     <Button Content="清除3D预览" Click="Clear3D_Click" ToolTip="清除临时实体并恢复本次预览改变的组件显示，保留二维草稿"/>
    </WrapPanel></DockPanel></Border>
    <Border DockPanel.Dock="Top" Style="{StaticResource BridgeToolbarBorderStyle}" Padding="7,3"><WrapPanel>
     <CheckBox IsChecked="{Binding ShowFrames}" Margin="3,1,8,1" AutomationProperties.Name="基架/基座"><StackPanel Orientation="Horizontal">
      <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#54778F" Margin="0,0,3,0"/><TextBlock Text="基架/基座"/>
     </StackPanel></CheckBox>
     <CheckBox IsChecked="{Binding ShowInsulators}" Margin="3,1,8,1" AutomationProperties.Name="绝缘子"><StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="#8852B0" Margin="0,0,3,0"/><TextBlock Text="绝缘子"/>
     </StackPanel></CheckBox>
     <CheckBox IsChecked="{Binding ShowBusbars}" Margin="3,1,8,1" AutomationProperties.Name="铜排"><StackPanel Orientation="Horizontal">
      <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#C46A24" Margin="0,0,3,0"/><TextBlock Text="铜排"/>
     </StackPanel></CheckBox>
     <CheckBox Content="柜体/墙体/套管" IsChecked="{Binding ShowReferences}" Margin="3,1,8,1"/>
     <TextBlock Text="相别显示" Margin="5,1" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding PhaseFilter}" Width="62"/>
     <Button Content="选择方案（Web预览）" Click="SelectWallScheme_Click" IsEnabled="{Binding CanSwitchWallSolution}"
      Visibility="{Binding HasWallSolutions, Converter={StaticResource FrameSelectionVisibility}}" Margin="4,2"/>
    </WrapPanel></Border>
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BridgeToolbarBorderBrush}">
     <StackPanel>
      <TextBlock Text="点击节号或基架定位参数；点击铜排选择段排；接缝可沿桥向拖动；滚轮缩放" TextWrapping="Wrap" Foreground="{StaticResource BridgeMutedBrush}"/>
      <TextBlock Text="{Binding NativePreviewStatus}" TextWrapping="Wrap" Foreground="#9B5700">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </Border>
    <Grid Background="#F1F5F9">
     <Grid Margin="7,7">
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="7"/><RowDefinition Height="*" MinHeight="120"/></Grid.RowDefinitions>
      <Border Style="{StaticResource BridgePreviewViewFrame}"><DockPanel>
       <Border DockPanel.Dock="Top" Style="{StaticResource BridgePreviewViewHeading}">
        <TextBlock Text="俯视图" FontWeight="SemiBold" ToolTip="总装X–Z平面：X向右，Z向下"/>
       </Border>
       <ContentControl x:Name="TopPreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </DockPanel></Border>
      <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                    Style="{StaticResource BridgeSplitterStyle}"/>
      <Border Grid.Row="2" Style="{StaticResource BridgePreviewViewFrame}"><DockPanel>
       <Border DockPanel.Dock="Top" Style="{StaticResource BridgePreviewViewHeading}">
        <TextBlock Text="正视图（侧视）" FontWeight="SemiBold" ToolTip="总装X–Y平面：X向右，Y向上"/>
       </Border>
       <local:BusbarBridgeJointPreviewControl x:Name="JointPreview"/>
      </DockPanel></Border>
     </Grid>
     <Border x:Name="ReadLoadingShade" Background="{StaticResource BridgePreviewBackgroundBrush}" Cursor="Wait" Visibility="Collapsed" AutomationProperties.Name="正在读取装配体并准备设计预览"/>
     <Border Background="{StaticResource BridgePreviewBackgroundBrush}" Cursor="Wait" AutomationProperties.Name="正在规划母线桥方案">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding PlanningBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="20">
       <Control Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
        <Control.Template><ControlTemplate TargetType="Control">
         <Grid><Ellipse Stroke="#C3CDDB" StrokeThickness="3" Margin="3"/>
          <Path Stroke="#2873CB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
           Data="M 20,3 A 17,17 0 1 1 3,20" RenderTransformOrigin="0.5,0.5">
           <Path.RenderTransform><RotateTransform x:Name="PlanningSpinnerRotation"/></Path.RenderTransform>
          </Path>
         </Grid>
         <ControlTemplate.Triggers><Trigger Property="IsVisible" Value="True">
          <Trigger.EnterActions><BeginStoryboard x:Name="PlanningSpinnerAnimation"><Storyboard>
           <DoubleAnimation Storyboard.TargetName="PlanningSpinnerRotation" Storyboard.TargetProperty="Angle"
            From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="PlanningSpinnerAnimation"/></Trigger.ExitActions>
         </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Control.Template>
       </Control>
       <TextBlock Text="正在规划方案…" HorizontalAlignment="Center" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#59697E"/>
      </StackPanel>
     </Border>
    </Grid>
   </DockPanel></Border>
  </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </Window.Resources>
 <Grid IsEnabled="{Binding IsEditingEnabled}" UseLayoutRounding="True" TextElement.Foreground="#1F2937">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#EDF4FC" BorderBrush="{StaticResource BridgeToolbarBorderBrush}" BorderThickness="0,1,0,1" Padding="18,6">
  <StackPanel Orientation="Horizontal">
   <TextBlock VerticalAlignment="Center" FontSize="13">
    <Run Text="{Binding SceneAndSpanSummary, Mode=OneWay}"/>
    <Run Text="&#160;&#160;&#160;搭接长度："/><Run Text="{Binding DisplayOverlapLengthMm, Mode=OneWay, StringFormat=F1, TargetNullValue=--}"/><Run Text=" mm"/>
   </TextBlock>
   <Border Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="8"
           BorderBrush="{StaticResource BridgeMutedBrush}" BorderThickness="1" Background="Transparent" Cursor="Help"
           AutomationProperties.Name="母排规划说明" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
    <Border.ToolTip><ToolTip Placement="Bottom" MaxWidth="560"
                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
     <TextBlock Text="{Binding PlanningNotice}" TextWrapping="Wrap" MaxWidth="520"/>
    </ToolTip></Border.ToolTip>
    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource BridgeMutedBrush}"/>
   </Border>
  </StackPanel>
 </Border>
 <Border x:Name="DraftViewportToolbar" Visibility="Collapsed" Grid.Row="1" Margin="10,6,10,0" Style="{StaticResource BridgeCardStyle}"
         IsEnabled="{Binding IsEditingEnabled}">
  <StackPanel>
   <WrapPanel>
    <CheckBox Content="铜排" IsChecked="{Binding ShowBusbars}" Margin="4"/><CheckBox Content="基架/基座" IsChecked="{Binding ShowFrames}" Margin="4"/>
    <CheckBox Content="绝缘子" IsChecked="{Binding ShowInsulators}" Margin="4"/><CheckBox Content="柜体/墙体/套管" IsChecked="{Binding ShowReferences}" Margin="4"/>
    <ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding PhaseFilter}" Width="65"/>
    <CheckBox Content="柜体/基座尺寸" IsChecked="{Binding ShowCabinetDimensions}" Margin="12,4,4,4" ToolTip="勾选后显示柜体界面的全部尺寸；不勾选时只显示选中柜体或基座的尺寸。"/>
   </WrapPanel>
   <WrapPanel>
    <Button Content="整体" Tag="All" Click="DraftView_Click"/><Button Content="定位选中" Tag="Selected" Click="DraftView_Click"/>
    <Button Content="俯视" Tag="Top" Click="DraftView_Click"/><Button Content="前视" Tag="Front" Click="DraftView_Click"/><Button Content="等轴测" Tag="Isometric" Click="DraftView_Click"/>
    <Button Content="选择方案" Click="SelectWallScheme_Click" IsEnabled="{Binding CanSwitchWallSolution}" Visibility="{Binding HasWallSolutions, Converter={StaticResource FrameSelectionVisibility}}"/>
    <ComboBox ItemsSource="{Binding ViewportReferences}" DisplayMemberPath="DisplayName"
              SelectedItem="{Binding SelectedViewportReference, Mode=TwoWay}" MaxWidth="220"
              ToolTip="选择柜体、基座或墙等参考对象"
              Visibility="{Binding HasViewportReferences, Converter={StaticResource FrameSelectionVisibility}}"/>
   </WrapPanel>
  </StackPanel>
 </Border>
