      <Button MinHeight="24" Margin="0" Padding="3,1" BorderThickness="0" Click="LocateGenerationIssue_Click"
              Foreground="{StaticResource BridgeIssueBrush}">
       <Button.Content><MultiBinding Converter="{StaticResource ObjectListValueConverter}" ConverterParameter="NumberedIssue" Mode="OneWay">
        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
        <Binding Path="Message"/>
       </MultiBinding></Button.Content>
       <Button.ToolTip><ToolTip MaxWidth="600" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <StackPanel>
         <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
         <TextBlock Text="点击定位到预览中的问题对象或红色区域" Margin="0,4,0,0" Foreground="{StaticResource BridgeMutedBrush}"/>
        </StackPanel>
       </ToolTip></Button.ToolTip>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </Border>
  <Border x:Name="DesignActions" Style="{StaticResource BridgeCardStyle}" Padding="8,4"><DockPanel>
   <StackPanel x:Name="DetachedPreviewActions" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
    <Button Content="找回预览窗口 ↗" Click="DetachPreview_Click"/>
    <Button Content="停靠预览" Click="DockPreview_Click"/>
   </StackPanel>
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,2,0,0">
    <Button x:Name="DraftPreviousButton" Content="上一步" Visibility="Collapsed" Click="DraftPrevious_Click"
            IsEnabled="{Binding IsEditingEnabled}"/>
    <Button Content="重读并规划" IsEnabled="{Binding HasUpstreamReader}" Click="ReloadUpstream_Click"
            ToolTipService.ShowOnDisabled="True" ToolTip="以当前SolidWorks总装重新读取并规划，替换当前草稿、锁定及未生成的吊架修改"/>
    <Button Content="撤销" Command="{Binding UndoCommand}" ToolTipService.ShowOnDisabled="True"
            ToolTip="撤销上一步草稿修改；没有可撤销操作或输入尚未提交时不可用"/>
    <Button Content="重做" Command="{Binding RedoCommand}" ToolTipService.ShowOnDisabled="True"
            ToolTip="恢复刚撤销的草稿修改；没有可重做操作或输入尚未提交时不可用"/>
    <Button Content="修复贯通" Command="{Binding RepairCommand}" ToolTipService.ShowOnDisabled="True"
            ToolTip="按当前柜端接口修复铜排和基架；自动解除冲突支撑的人工定位并重新规划，保留未受影响的人工调整及锁定。先更新预览，可撤销；生成后才写入模型"/>
   <Button x:Name="GenerateModelButton" Content="生成正式模型" Click="GenerateUnavailable_Click" IsEnabled="{Binding IsEditingEnabled}" ToolTipService.ShowOnDisabled="True"
           ToolTip="试用版暂未开放实体生成"/>
   </WrapPanel>
   <TextBlock x:Name="DesignStatus" Margin="8,0,4,0" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
             ClipToBounds="True" AutomationProperties.Name="方案状态"
             ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
   <TextBlock.ToolTip><ToolTip MaxWidth="760" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="700"/>
    </ScrollViewer>
   </ToolTip></TextBlock.ToolTip>
   <TextBlock.Style><Style TargetType="TextBlock">
    <Setter Property="Text" Value="{Binding Message}"/>
    <Setter Property="Tag" Value="{Binding Message}"/>
    <Setter Property="Foreground" Value="{StaticResource BridgeMutedBrush}"/>
    <Style.Triggers>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding HasGenerationBlockers}" Value="True"/>
       <Condition Binding="{Binding IsModelPlannedPreview}" Value="True"/>
       <Condition Binding="{Binding GenerationBusy}" Value="False"/>
       <Condition Binding="{Binding PlanningBusy}" Value="False"/>
       <Condition Binding="{Binding NativePreviewBusy}" Value="False"/>
      </MultiDataTrigger.Conditions>
      <Setter Property="Text" Value="{Binding GenerationBlockerSummary, StringFormat={}{0}；点击上方问题定位，图中红色为问题区域}"/>
      <Setter Property="Tag" Value="{Binding GenerationToolTip}"/>
      <Setter Property="Foreground" Value="#9B5700"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style></TextBlock.Style>
   </TextBlock>
  </DockPanel></Border>
  <StackPanel HorizontalAlignment="Right" Margin="8,4,8,0" MaxWidth="360">
   <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding GenerationBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style></StackPanel.Style>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4"/>
   <ProgressBar Height="6" Width="240" IsIndeterminate="True" HorizontalAlignment="Right"/>
  </StackPanel>
 </StackPanel>
 </Grid>
</Window>
