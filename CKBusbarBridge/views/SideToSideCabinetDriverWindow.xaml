<Window Style="{DynamicResource SmallCornerWindowStyle}" x:Class="CKBusbarBridge.views.SideToSideCabinetDriverWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:CKBusbarBridge.views"
             xmlns:designUi="clr-namespace:CKBusbarBridge.views;assembly=CKBusbarBridge.DesignUI"
             mc:Ignorable="d" 
        Title="柜体驱动 - 侧对侧场景"
        Width="1520" Height="900"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="InputTextBox_PreviewKeyDown"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CKBusbarBridge;component/views/SmallCornerWindowResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <designUi:DimensionHighlightVisibilityConverter x:Key="DimensionHighlightVisibilityConverter" />

            <Style x:Key="PreviewImageStyle" TargetType="Image">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图6.png" />
                <Setter Property="Tag" Value="示意图6.png" />
                <Style.Triggers>
                    <!-- 整体和柜体参数按基座结构选图；柜顶开孔几何始终为前后开孔。 -->
                    <DataTrigger Binding="{Binding Parameters.General.BaseKind}" Value="Base1">
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图4.png" />
                        <Setter Property="Tag" Value="示意图4.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Parameters.General.BaseKind}" Value="Base2">
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图6.png" />
                        <Setter Property="Tag" Value="示意图6.png" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=ATabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=AHoleParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.CabinetTopOpeningMode}" Value="FrontRear" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图2.png" />
                        <Setter Property="Tag" Value="示意图2.png" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BTabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=BHoleParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.CabinetTopOpeningMode}" Value="FrontRear" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图2.png" />
                        <Setter Property="Tag" Value="示意图2.png" />
                    </MultiDataTrigger>

                    <!-- 基座选型与统一的柜体前后开孔几何独立。 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=ATabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=ABaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base1" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/侧对侧基座1.png" />
                        <Setter Property="Tag" Value="侧对侧基座1.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=ATabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=ABaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base2" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/侧对侧基座2.png" />
                        <Setter Property="Tag" Value="侧对侧基座2.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BTabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=BBaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base1" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/侧对侧基座1.png" />
                        <Setter Property="Tag" Value="侧对侧基座1.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BTabItem}" Value="True" />
                            <Condition Binding="{Binding IsSelected, ElementName=BBaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base2" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/侧对侧基座2.png" />
                        <Setter Property="Tag" Value="侧对侧基座2.png" />
                    </MultiDataTrigger>
                    <!-- 整体参数取得焦点时，按当前基座结构恢复整体示意图。 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=GeneralParametersPanel}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base1" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图4.png" />
                        <Setter Property="Tag" Value="示意图4.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=GeneralParametersPanel}" Value="True" />
                            <Condition Binding="{Binding Parameters.General.BaseKind}" Value="Base2" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图6.png" />
                        <Setter Property="Tag" Value="示意图6.png" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="96" />
            </Style>

            <Style x:Key="HoleParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="150" />
            </Style>

            <Style x:Key="RoundedInputBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="32" />
                <Setter Property="Width" Value="120" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="ParamTextBoxStyle" TargetType="hc:TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="hc:InfoElement.Placeholder" Value="请输入参数值" />
                <EventSetter Event="GotKeyboardFocus" Handler="DimensionTextBox_GotKeyboardFocus" />
            </Style>

            <!-- 换相不偏移使用基座1：L1、L2、L3取所属柜顶孔参数。 -->
            <DataTemplate x:Key="SideToSideBase1ParameterTemplate">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding BaseHeight, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="绝缘子定位1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="绝缘子定位1" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding InsulatorPosition1, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="绝缘子定位2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="绝缘子定位2" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding InsulatorPosition2, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="绝缘子定位3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="绝缘子定位3" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding InsulatorPosition3, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- 前后开孔使用基座2：界面基座高为基座2与增高基座的组合总高。 -->
            <DataTemplate x:Key="SideToSideBase2ParameterTemplate">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="组合基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="组合基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding BaseHeight, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="增高基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="增高基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding ElevatedBaseHeight, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Margin="162,0,0,10">
                        <TextBlock x:Name="Base2HeightHintTextBlock"
                                   Text="{Binding Base2Height, StringFormat=基架2高度：{0:0.###}}"
                                   FontSize="12"
                                   Foreground="#8C8C8C" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="基座2宽：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource RoundedInputBorderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Base2WidthTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F5222D" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <hc:TextBox x:Name="Base2WidthTextBox"
                                        Tag="基座2宽"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding BaseWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Base2WidthErrorTextBlock"
                               Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=Base2WidthTextBox}"
                               Margin="162,0,0,10"
                               FontSize="12"
                               Foreground="#F5222D">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Base2WidthTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource RoundedInputBorderStyle}"><hc:TextBox Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource RoundedInputBorderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Base2InsulatorPositionTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F5222D" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <hc:TextBox x:Name="Base2InsulatorPositionTextBox"
                                        Tag="绝缘子定位"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding InsulatorPosition, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Base2InsulatorPositionErrorTextBlock"
                               Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=Base2InsulatorPositionTextBox}"
                               Margin="162,0,0,0"
                               FontSize="12"
                               Foreground="#F5222D">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Base2InsulatorPositionTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ParamComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="MainBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          Margin="0,0,4,0"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                        <Path Grid.Column="1"
                                              Width="10"
                                              Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="#8C8C8C"
                                              Data="M 0 0 L 5 6 L 10 0 Z" />
                                    </Grid>
                                </Border>

                                <Popup x:Name="Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Background="White"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <ScrollViewer MaxHeight="240"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="#BFBFBF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="#1677FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VerticalSideTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource TabItemInLine}">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <Style x:Key="VerticalSideTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource TabControlInLine}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource VerticalSideTabItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid x:Name="templateRoot" Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition0" />
                                    <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                                    <RowDefinition x:Name="RowDefinition1" Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Rows="1"
                                             x:Name="headerPanel"
                                             VerticalAlignment="Top"
                                             KeyboardNavigation.TabNavigation="Once"
                                             KeyboardNavigation.DirectionalNavigation="Cycle"
                                             Background="Transparent"
                                             Grid.Column="0"
                                             IsItemsHost="True"
                                             Margin="0"
                                             Grid.Row="0" />
                                <Border x:Name="contentPanel"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{TemplateBinding Background}"
                                        Grid.Column="0"
                                        Grid.Row="1">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="0"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TabStripPlacement" Value="Bottom">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="Auto" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Left">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="Auto" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                                    <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto" />
                                    <Setter TargetName="ColumnDefinition1" Property="Width" Value="*" />
                                    <Setter TargetName="contentPanel" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Rows" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Columns" Value="1" />
                                    <Setter TargetName="headerPanel" Property="VerticalAlignment" Value="Top" />
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Right">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="Auto" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                                    <Setter TargetName="ColumnDefinition0" Property="Width" Value="*" />
                                    <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto" />
                                    <Setter TargetName="contentPanel" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Rows" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Columns" Value="1" />
                                    <Setter TargetName="headerPanel" Property="VerticalAlignment" Value="Top" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E6F4FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="GenerateDrawingNumberButton" Grid.Column="0" Content="图号生成" Width="100" Height="28" Click="GenerateDrawingNumber_Click" />
            <TextBlock Grid.Column="2" Text="项目根目录" VerticalAlignment="Center" />
            <hc:TextBox x:Name="ProjectPathTextBox" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Text="{Binding ProjectPath, UpdateSourceTrigger=LostFocus}" />
            <Button x:Name="SelectProjectPathButton" Grid.Column="6" Content="设置项目根目录" Height="28" Padding="12,0" Command="{Binding SelectProjectPathCommand}" />
            <Border x:Name="CabinetScenarioBadge" Grid.Column="8"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="#E6F4FF"
                    BorderBrush="#91CAFF"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Text="{Binding ScenarioDisplayName}"
                           Foreground="#0958D9"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="GeneralParametersPanel" Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,2">
                        <StackPanel>
