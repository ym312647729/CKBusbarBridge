                                                <hc:TextBox x:Name="BCabinetDepthTextBox" Tag="B-柜深" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入B柜柜深" Text="{Binding Parameters.BCabinet.CabinetDepth, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="柜宽" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <hc:TextBox x:Name="BCabinetWidthTextBox" Tag="B-柜宽" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入B柜柜宽" Text="{Binding Parameters.BCabinet.CabinetWidth, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="离地高度(I)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <hc:TextBox x:Name="BTextBoxI" Tag="B-离地高度(I)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入B柜参数I" Text="{Binding Parameters.BCabinet.GroundHeight, UpdateSourceTrigger=LostFocus}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </TabItem>

                                <TabItem x:Name="BHoleParamTabItem" Header="柜顶开孔参数">
                                    <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,2" MinHeight="620">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="柜前孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="BFrontHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.BCabinet.FrontHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
                                            </Grid>

                                            <Grid Margin="22,0,0,24" IsEnabled="{Binding IsChecked, ElementName=BFrontHoleToggleButton}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="距柜前距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontHoleToFrontDistanceTextBox" Tag="柜前孔-距柜前距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入距柜前距离" Text="{Binding Parameters.BCabinet.FrontHole.ToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="铜排中心至柜前距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontHoleBusbarCenterToFrontDistanceTextBox" Tag="柜前孔-铜排中心至柜前距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入铜排中心至柜前距离" Text="{Binding Parameters.BCabinet.FrontHole.BusbarCenterToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="接口固定孔间距：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontHoleFixedHoleSpacingTextBox" Tag="柜前孔-接口固定孔间距" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入接口固定孔间距" Text="{Binding Parameters.BCabinet.FrontHole.FixedHoleSpacing, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontHoleL1TextBox" Tag="柜前孔-L1" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L1" Text="{Binding Parameters.BCabinet.FrontHole.L1, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontHoleL2TextBox" Tag="柜前孔-L2" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L2" Text="{Binding Parameters.BCabinet.FrontHole.L2, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                                    <hc:TextBox x:Name="BFrontHoleL3TextBox" Tag="柜前孔-L3" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L3" Text="{Binding Parameters.BCabinet.FrontHole.L3, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                            </Grid>

                                            <Grid Margin="0,0,0,12" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="柜后孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="BBackHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.BCabinet.BackHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
                                            </Grid>

                                            <Grid Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=BBackHoleToggleButton}" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="BBackHoleToCabinetEdgeDistanceLabel" Grid.Row="0" Grid.Column="0" Text="{Binding Parameters.General.BackHoleToCabinetEdgeDistanceDisplayName, Mode=OneWay}" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackHoleToBackDistanceTextBox" Tag="柜后孔-距柜后距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入距柜后距离" Text="{Binding Parameters.BCabinet.BackHole.ToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="铜排中心至柜后距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackHoleBusbarCenterToBackDistanceTextBox" Tag="柜后孔-铜排中心至柜后距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入铜排中心至柜后距离" Text="{Binding Parameters.BCabinet.BackHole.BusbarCenterToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="接口固定孔间距：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackHoleFixedHoleSpacingTextBox" Tag="柜后孔-接口固定孔间距" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入接口固定孔间距" Text="{Binding Parameters.BCabinet.BackHole.FixedHoleSpacing, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackHoleL1TextBox" Tag="柜后孔-L1" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L1" Text="{Binding Parameters.BCabinet.BackHole.L1, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackHoleL2TextBox" Tag="柜后孔-L2" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L2" Text="{Binding Parameters.BCabinet.BackHole.L2, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                                    <hc:TextBox x:Name="BBackHoleL3TextBox" Tag="柜后孔-L3" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L3" Text="{Binding Parameters.BCabinet.BackHole.L3, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem x:Name="BBaseParamTabItem" Header="基座参数">
                                    <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,2" MinHeight="620">
                                        <StackPanel>
                                            <TextBlock Text="柜前孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Grid Margin="22,0,0,24" IsEnabled="{Binding Parameters.BCabinet.FrontHole.IsEnabled}">
                                                <ContentControl Content="{Binding Parameters.BCabinet.FrontHole.Base1}" ContentTemplate="{StaticResource SideToSideBase1ParameterTemplate}" Visibility="{Binding Parameters.BCabinet.FrontHole.ActiveBase1Visibility}" />
                                                <ContentControl Content="{Binding Parameters.BCabinet.FrontHole.Base2}" ContentTemplate="{StaticResource SideToSideBase2ParameterTemplate}" Visibility="{Binding Parameters.BCabinet.FrontHole.ActiveBase2Visibility}" />
                                            </Grid>

                                            <TextBlock Text="柜后孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="Collapsed" />
                                            <Grid Margin="22,0,0,0" IsEnabled="{Binding Parameters.BCabinet.BackHole.IsEnabled}" Visibility="Collapsed">
                                                <ContentControl Content="{Binding Parameters.BCabinet.BackHole.Base1}" ContentTemplate="{StaticResource SideToSideBase1ParameterTemplate}" Visibility="{Binding Parameters.BCabinet.BackHole.ActiveBase1Visibility}" />
                                                <ContentControl Content="{Binding Parameters.BCabinet.BackHole.Base2}" ContentTemplate="{StaticResource SideToSideBase2ParameterTemplate}" Visibility="{Binding Parameters.BCabinet.BackHole.ActiveBase2Visibility}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Padding="12" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                <Grid ClipToBounds="True">
                    <Image x:Name="PreviewImage"
                           Style="{StaticResource PreviewImageStyle}"
                           SizeChanged="PreviewImage_SizeChanged" />
                    <Canvas x:Name="DimensionHighlightCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Rectangle Stroke="#FFFF0000"
                                   StrokeThickness="1.5"
                                   Fill="#20FF0000"
                                   Canvas.Left="{Binding DimensionHighlightLeft}"
                                   Canvas.Top="{Binding DimensionHighlightTop}"
                                   Width="{Binding DimensionHighlightWidth}"
                                   Height="{Binding DimensionHighlightHeight}"
                                   SnapsToDevicePixels="True">
                            <Rectangle.Visibility>
                                <MultiBinding Converter="{StaticResource DimensionHighlightVisibilityConverter}">
                                    <Binding Path="DimensionHighlightVisibility" />
                                    <Binding Path="Tag" ElementName="PreviewImage" />
                                    <Binding Path="ActiveDimensionImageName" />
                                </MultiBinding>
                            </Rectangle.Visibility>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="GenerateButton" Content="生成" Width="100" Height="32" Margin="0,0,32,0" Visibility="{Binding GenerateButtonVisibility}" Style="{StaticResource ButtonPrimary}" Command="{Binding GenerateCommand}" />
        </StackPanel>

    </Grid>
</Window>

