<rd:RDWindow x:Class="CKBusbarBridge.views.BusbarWebPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:rd="clr-namespace:RD.UI.Wpf.Controls;assembly=RD.UI.Wpf"
        Title="母排方案 Web 预览"
        Width="400"
        Height="540"
        MinWidth="340"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#ECEEF1"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeChanged="BusbarWebPreviewWindow_SizeChanged"
        StateChanged="BusbarWebPreviewWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="6"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <rd:RDWindow.Resources><ResourceDictionary Source="pack://application:,,,/RD.UI.Wpf;component/Themes/Generic.xaml" /></rd:RDWindow.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
          SnapsToDevicePixels="True">
    <Border BorderBrush="#D0D5DD"
            BorderThickness="1"
            Background="#F7F8FA" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="0,0,0,1" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="#2563EB"
                            CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="RD"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="PreviewTitleTextBlock"
                               Grid.Column="1"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Text="母排方案 Web 预览"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#1F2937"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <rd:RDButton x:Name="PrototypeCloseButton" Grid.Column="2" Content="×" Width="24" Height="24"
                            Margin="5,0,0,0" Visibility="Collapsed" ToolTip="关闭只读三维预览"
                            Click="PrototypeCloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8">
                <Border Background="White"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        CornerRadius="4" />
                <wv2:WebView2 x:Name="PreviewWebView" Margin="1" />
            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,5,5">
                <TextBlock x:Name="PreviewStatusTextBlock"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="等待方案数据。"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#667085"
                           FontSize="10" />
            </Border>

            <Border Grid.RowSpan="3"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="SizeNWSE"
                    Panel.ZIndex="20"
                    shell:WindowChrome.ResizeGripDirection="BottomRight">
                <Path Width="8"
                      Height="8"
                      Margin="0,0,3,3"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Stroke="#667085"
                      StrokeThickness="1"
                      Data="M 0,8 L 8,0 M 4,8 L 8,4" />
            </Border>
        </Grid>
    </Border>
    </Grid>
</rd:RDWindow>
