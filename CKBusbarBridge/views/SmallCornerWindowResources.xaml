<ResourceDictionary x:Class="CKBusbarBridge.views.SmallCornerWindowResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CKBusbarBridge.views"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- 非透明窗口保留 WebView2 等原生子窗口的显示能力。 -->
    <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#344054" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="#E4E7EC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="#D0D5DD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallCornerWindowStyle" TargetType="Window">
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="4"
                                    CornerRadius="6" GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- WindowChrome负责裁剪轮廓；不透明底色避免抗锯齿边缘露出HWND黑底。 -->
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <Border x:Name="WindowFrame" Background="{TemplateBinding Background}"
                            BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="CaptionBorder" Background="White" CornerRadius="5,5,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Margin="12,0" ClipToBounds="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Title}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Microsoft YaHei" FontSize="12" Foreground="#1F2937" />
                                        <ContentPresenter VerticalAlignment="Center"
                                                          Content="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ContentTemplate="{Binding Path=(local:SmallCornerWindowResources.CaptionDetailsTemplate), RelativeSource={RelativeSource TemplatedParent}}">
                                            <ContentPresenter.Style>
                                                <Style TargetType="ContentPresenter">
                                                    <Style.Triggers>
                                                        <Trigger Property="ContentTemplate" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentPresenter.Style>
                                        </ContentPresenter>
                                    </DockPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButtonStyle}"
                                                ToolTip="最小化" AutomationProperties.Name="最小化"
                                                Click="Minimize_Click">
                                            <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                        </Button>
                                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButtonStyle}"
                                                ToolTip="最大化" AutomationProperties.Name="最大化或还原"
                                                Click="MaximizeRestore_Click">
                                            <Path x:Name="MaximizeGlyph" Data="M 0,0 L 10,0 10,10 0,10 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                        </Button>
                                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                                ToolTip="关闭" AutomationProperties.Name="关闭" Click="Close_Click">
                                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 最大化时贴合工作区；还原后恢复6px外轮廓。 -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowFrame" Property="CornerRadius" Value="0" />
                            <Setter TargetName="CaptionBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="MaximizeButton" Property="ToolTip" Value="还原" />
                            <Setter TargetName="MaximizeGlyph" Property="Data" Value="M 0,3 L 7,3 7,10 0,10 Z M 3,3 L 3,0 10,0 10,7 7,7" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaximizeButton" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
