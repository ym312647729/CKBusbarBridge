                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontHoleL1TextBox" Tag="柜前孔-L1" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L1" Text="{Binding Parameters.Cabinet.FrontHole.L1, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontHoleL2TextBox" Tag="柜前孔-L2" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L2" Text="{Binding Parameters.Cabinet.FrontHole.L2, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontHoleL3TextBox" Tag="柜前孔-L3" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L3" Text="{Binding Parameters.Cabinet.FrontHole.L3, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="柜后孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="BackHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.Cabinet.BackHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
                                </Grid>

                                <Grid Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=BackHoleToggleButton}" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="基座距柜后距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleToBackDistanceTextBox" Tag="柜后孔-距柜后距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基座距柜后距离" Text="{Binding Parameters.Cabinet.BackHole.BaseToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="铜排中心至柜后距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleBusbarCenterToBackDistanceTextBox" Tag="柜后孔-铜排中心至柜后距离" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入铜排中心至柜后距离" Text="{Binding Parameters.Cabinet.BackHole.BusbarCenterToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="接口固定孔间距：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleFixedHoleSpacingTextBox" Tag="柜后孔-接口固定孔间距" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入接口固定孔间距" Text="{Binding Parameters.Cabinet.BackHole.FixedHoleSpacing, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleL1TextBox" Tag="柜后孔-L1" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L1" Text="{Binding Parameters.Cabinet.BackHole.L1, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleL2TextBox" Tag="柜后孔-L2" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L2" Text="{Binding Parameters.Cabinet.BackHole.L2, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackHoleL3TextBox" Tag="柜后孔-L3" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L3" Text="{Binding Parameters.Cabinet.BackHole.L3, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="BaseParamTabItem" Header="基座参数">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,2" MinHeight="520">
                            <StackPanel>
                                <TextBlock Text="柜前孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <!-- 直接跟随开孔开关，确保用户切换后立即刷新；禁用编辑时不丢弃已填值。 -->
                                <Grid x:Name="FrontBaseParameterGroup" Margin="22,0,0,24" IsEnabled="{Binding IsChecked, ElementName=FrontHoleToggleButton}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontInsulatorPositionTextBox" Tag="绝缘子定位" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入绝缘子定位" Text="{Binding Parameters.Cabinet.FrontHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontBaseOpeningHeightTextBox" Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基架高度" Text="{Binding Parameters.Cabinet.FrontHole.BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="FrontBaseHeightTextBox" Tag="基座高" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基座高" Text="{Binding Parameters.Cabinet.FrontHole.BaseHeight, UpdateSourceTrigger=LostFocus}" TextChanged="BaseHeightTextBox_TextChanged" />
                                    </Border>

                                    <TextBlock x:Name="FrontExtensionBaseHintTextBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="基座高超过1400将添加延长基座" Foreground="#D46B08" Margin="0,0,0,10" Visibility="Collapsed" />

                                    <StackPanel x:Name="FrontExtensionBasePanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="延长基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource RoundedInputBorderStyle}">
                                                <hc:TextBox x:Name="FrontExtensionBaseTextBox" Tag="延长基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Parameters.Cabinet.FrontHole.ExtensionBaseHeight, UpdateSourceTrigger=LostFocus}" hc:InfoElement.Placeholder="请输入延长基座高" TextChanged="ExtensionBaseTextBox_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="FrontBasicBaseHeightTextBlock" Margin="158,4,0,0" FontSize="12" Foreground="#999999" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="柜后孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="Collapsed" />
                                <Grid x:Name="BackBaseParameterGroup" Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=BackHoleToggleButton}" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackInsulatorPositionTextBox" Tag="绝缘子定位" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入绝缘子定位" Text="{Binding Parameters.Cabinet.BackHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackBaseOpeningHeightTextBox" Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基架高度" Text="{Binding Parameters.Cabinet.BackHole.BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <hc:TextBox x:Name="BackBaseHeightTextBox" Tag="基座高" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基座高" Text="{Binding Parameters.Cabinet.BackHole.BaseHeight, UpdateSourceTrigger=LostFocus}" TextChanged="BaseHeightTextBox_TextChanged" />
                                    </Border>

                                    <TextBlock x:Name="BackExtensionBaseHintTextBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="基座高超过1400将添加延长基座" Foreground="#D46B08" Margin="0,0,0,10" Visibility="Collapsed" />

                                    <StackPanel x:Name="BackExtensionBasePanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="延长基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource RoundedInputBorderStyle}">
                                                <hc:TextBox x:Name="BackExtensionBaseTextBox" Tag="延长基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Parameters.Cabinet.BackHole.ExtensionBaseHeight, UpdateSourceTrigger=LostFocus}" hc:InfoElement.Placeholder="请输入延长基座高" TextChanged="ExtensionBaseTextBox_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="BackBasicBaseHeightTextBlock" Margin="158,4,0,0" FontSize="12" Foreground="#999999" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" Padding="12" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                <Grid ClipToBounds="True">
                    <Image x:Name="PreviewImage"
                           Style="{StaticResource PreviewImageStyle}"
                           SizeChanged="PreviewImage_SizeChanged" />
                    <Canvas x:Name="DimensionHighlightCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Rectangle Stroke="#FFFF0000"
                                   StrokeThickness="1.5"
                                   Fill="#20FF0000"
                                   Canvas.Left="{Binding DimensionHighlightLeft}"
                                   Canvas.Top="{Binding DimensionHighlightTop}"
                                   Width="{Binding DimensionHighlightWidth}"
                                   Height="{Binding DimensionHighlightHeight}"
                                   SnapsToDevicePixels="True">
                            <Rectangle.Visibility>
                                <MultiBinding Converter="{StaticResource DimensionHighlightVisibilityConverter}">
                                    <Binding Path="DimensionHighlightVisibility" />
                                    <Binding Path="Tag" ElementName="PreviewImage" />
                                    <Binding Path="ActiveDimensionImageName" />
                                </MultiBinding>
                            </Rectangle.Visibility>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="GenerateButton" Content="生成" Width="100" Height="32" Margin="0,0,32,0" Visibility="{Binding GenerateButtonVisibility}" Style="{StaticResource ButtonPrimary}" Command="{Binding GenerateCommand}" />
        </StackPanel>

    </Grid>
</Window>
