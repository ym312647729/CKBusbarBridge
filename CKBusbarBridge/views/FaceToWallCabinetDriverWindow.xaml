<UserControl x:Class="CKBusbarBridge.views.FaceToWallCabinetDriverWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rd="clr-namespace:RD.UI.Wpf.Controls;assembly=RD.UI.Wpf"
             xmlns:local="clr-namespace:CKBusbarBridge.views"
             xmlns:designUi="clr-namespace:CKBusbarBridge.views;assembly=CKBusbarBridge.DesignUI"
             mc:Ignorable="d"
        UseLayoutRounding="True"
        PreviewKeyDown="InputTextBox_PreviewKeyDown"
        Background="#F7F8FA"
        Foreground="#1F2937">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RD.UI.Wpf;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ParamSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#595959" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ParamHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#999999" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="96" />
            </Style>

            <Style x:Key="HoleParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="150" />
            </Style>

            <Style x:Key="RoundedInputBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding ScenarioDisplayName}" Style="{StaticResource RDText.H3}" Margin="0,0,0,12" />
            <TextBlock Text="项目根目录" Style="{StaticResource RDText.Caption}" Margin="0,0,0,4" />
            <rd:RDInput x:Name="ProjectPathTextBox"
                        Text="{Binding ProjectPath, UpdateSourceTrigger=LostFocus}" />
            <WrapPanel Margin="0,8,0,0">
                <rd:RDButton x:Name="SelectProjectPathButton" Content="选择项目目录"
                             Command="{Binding SelectProjectPathCommand}" Margin="0,0,8,8" />
                <rd:RDButton x:Name="GenerateDrawingNumberButton" Content="生成图号"
                             Click="GenerateDrawingNumber_Click" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">


            <rd:RDTabControl HeaderWrap="True" x:Name="GeneralParametersPanel" Grid.Column="0"

                         SelectedIndex="0"
                        SelectionChanged="ParameterTabControl_SelectionChanged">
                <TabItem x:Name="BuildingInstallationParamTabItem" Header="建筑与安装" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="建筑与安装" Style="{StaticResource ParamSectionTitleStyle}" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="楼高(L)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                         <rd:RDInput x:Name="BuildingHeightTextBox" Tag="楼高(L)" Text="{Binding Parameters.General.BuildingHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="地面距横梁(B)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                         <rd:RDInput x:Name="FloorToBeamDistanceTextBox" Tag="地面距横梁(B)" Text="{Binding Parameters.General.FloorToBeamDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="柜体离地(I)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <rd:RDInput x:Name="CabinetGroundHeightTextBox" Tag="柜体离地(I)" Text="{Binding Parameters.General.CabinetGroundHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WallDistanceDisplayName}" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <rd:RDInput x:Name="CabinetToWallDistanceTextBox" Tag="{Binding WallDistanceDisplayName}" Text="{Binding Parameters.General.CabinetToWallDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="墙孔边距地面(C)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <rd:RDInput x:Name="WallHoleEdgeGroundHeightTextBox" Tag="墙孔边距地面(C)" Text="{Binding Parameters.General.WallHoleEdgeGroundHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="墙柜偏心值" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallCabinetEccentricityTextBox" Text="{Binding Parameters.General.WallCabinetEccentricity, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WallHoleParamTabItem" Header="墙孔参数" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="墙孔参数" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="墙孔高度(E)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                         <rd:RDInput x:Name="WallHoleHeightTextBox" Tag="墙孔高度(E)" Text="{Binding Parameters.General.WallHoleHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="墙孔宽度(G)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                         <rd:RDInput x:Name="WallHoleWidthTextBox" Tag="墙孔宽度(G)" Text="{Binding Parameters.General.WallHoleWidth, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="末端基架安装参数" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="WallTopClearanceTextBox"  Text="{Binding Parameters.General.WallInstallation.Top, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="下间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="WallBottomClearanceTextBox"  Text="{Binding Parameters.General.WallInstallation.Bottom, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="左间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallLeftClearanceTextBox"  Text="{Binding Parameters.General.WallInstallation.Left, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="右间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallRightClearanceTextBox"  Text="{Binding Parameters.General.WallInstallation.Right, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="伸入墙距离(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallEntryDistanceTextBox"  Text="{Binding Parameters.General.WallInstallation.EntryDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                                <rd:RDButton x:Name="SynchronizeWallBaseParametersButton" Content="同步基座参数" HorizontalAlignment="Left" Padding="12,0" Height="28" Margin="0,12,0,0" Click="SynchronizeWallBaseParameters_Click" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="BusbarInsulatorParamTabItem" Header="母排与绝缘子" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="母排与绝缘子" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="铜排规格" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="BusbarSpecTextBox" Text="{Binding Parameters.General.BusbarSpec, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="单相根数" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDComboBox x:Name="SinglePhaseRootCountComboBox"
                                                  Height="30"



                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Parameters.General.SinglePhaseRootCount, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="3" Tag="3" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                        </rd:RDComboBox>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="伸出排相间距" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <rd:RDInput x:Name="ExposedBusbarPhaseSpacingTextBox" Tag="伸出排相间距"  ToolTip="相间距至少为排宽＋绝缘距离" Text="{Binding Parameters.General.ExposedBusbarPhaseSpacing, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="绝缘子+支架高度" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="InsulatorHeightTextBox" Text="{Binding Parameters.General.InsulatorHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="4"
                                               Text="（含支架高度：25）"
                                               ToolTip="支架高度为25 mm；输入总高不包含上方垫块。"
                                               Style="{StaticResource ParamHintStyle}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="绝缘距离(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="铜排材质" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDComboBox Height="30"
                                                  VerticalContentAlignment="Center" SelectedValuePath="Content"
                                                  SelectedValue="{Binding Parameters.General.BusbarMaterial, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="直角铜母线" />
                                            <ComboBoxItem Content="全圆边铜母线" />
                                        </rd:RDComboBox>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="InsulationDistanceTextBox" Text="{Binding Parameters.General.InsulationDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="是否换相" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDComboBox x:Name="IsPhaseSwitchedComboBox" Height="30"
                                                  VerticalContentAlignment="Center" SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Parameters.General.IsPhaseSwitched, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="否"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="是"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                                        </rd:RDComboBox>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WallBushingParamTabItem" Header="穿墙套管" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="穿墙套管" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="套管到左侧墙洞(F1)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="F1TextBox" Tag="套管到左侧墙洞(F1)" Text="{Binding Parameters.General.F1, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="第一、二套管中心距(F2)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="F2TextBox" Tag="第一、第二套管中心距(F2)" Text="{Binding Parameters.General.F2, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="第二、三套管中心距(F3)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="F3TextBox" Tag="第二、第三套管中心距(F3)" Text="{Binding Parameters.General.F3, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="安装板距内侧墙面(J)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="JTextBox" Tag="穿墙套管安装板距内侧墙面距离(J)" Text="{Binding Parameters.General.J, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="套管中心距孔底(D)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallEntryBusbarCenterToHoleBottomDistanceTextBox" Tag="套管中心距孔底(D)" Text="{Binding Parameters.General.WallEntryBusbarCenterToHoleBottomDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="桩头距墙面距离(H)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalToWallDistanceTextBox" Tag="穿墙套管桩头距墙面距离(H)" Text="{Binding Parameters.General.WallBushingTerminalToWallDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="桩头长度(C1)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC1TextBox" Tag="桩头长度(C1)" Text="{Binding Parameters.General.WallBushingTerminal.C1, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="桩头宽度(C2)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC2TextBox" Tag="桩头宽度(C2)" Text="{Binding Parameters.General.WallBushingTerminal.C2, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="桩头孔到前边距离(C3)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC3TextBox" Tag="桩头孔到前边的距离(C3)" Text="{Binding Parameters.General.WallBushingTerminal.C3, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="桩头孔垂直距离(C4)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC4TextBox" Tag="桩头孔垂直距离(C4)" Text="{Binding Parameters.General.WallBushingTerminal.C4, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="桩头孔到上边距离(C5)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC5TextBox" Tag="桩头孔到上边的距离(C5)" Text="{Binding Parameters.General.WallBushingTerminal.C5, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="5" Grid.Column="3" Text="桩头孔水平距离(C6)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC6TextBox" Tag="桩头孔水平距离(C6)" Text="{Binding Parameters.General.WallBushingTerminal.C6, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="桩头孔径(C7)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC7TextBox" Tag="桩头孔径(C7)" Text="{Binding Parameters.General.WallBushingTerminal.C7, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="6" Grid.Column="3" Text="桩头厚度(C8)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <rd:RDInput x:Name="WallBushingTerminalC8TextBox" Tag="桩头厚度(C8)" Text="{Binding Parameters.General.WallBushingTerminal.C8, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

