                <TabItem x:Name="BaseParamTabItem" Header="基座参数">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="520">
                            <StackPanel>
                                <TextBlock Text="柜前孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
