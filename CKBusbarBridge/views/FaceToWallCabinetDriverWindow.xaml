<Window Style="{DynamicResource SmallCornerWindowStyle}" x:Class="CKBusbarBridge.views.FaceToWallCabinetDriverWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:CKBusbarBridge.views"
             xmlns:designUi="clr-namespace:CKBusbarBridge.views;assembly=CKBusbarBridge.DesignUI"
             mc:Ignorable="d" 
        Title="柜体驱动 - 面对墙场景"
        Width="1620" Height="820"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="InputTextBox_PreviewKeyDown"
        Background="#F7F8FA"
        Foreground="#1F2937">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CKBusbarBridge;component/views/SmallCornerWindowResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <designUi:DimensionHighlightVisibilityConverter x:Key="DimensionHighlightVisibilityConverter" />

            <Style x:Key="PreviewImageStyle" TargetType="Image">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图3.png" />
                <Setter Property="Tag" Value="示意图3.png" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=HoleParamTabItem}" Value="True">
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图2.png" />
                        <Setter Property="Tag" Value="示意图2.png" />
                    </DataTrigger>
                    <!-- 基座参数图按柜体向墙方向切换；任一已启用基座需要延长基座时显示带延长的版本。 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetFrontToWall" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜前向墙.png" />
                        <Setter Property="Tag" Value="柜前向墙.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetRearToWall" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜后向墙.png" />
                        <Setter Property="Tag" Value="柜后向墙.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetFrontToWall" />
                            <Condition Binding="{Binding IsEnabled, ElementName=FrontBaseParameterGroup}" Value="True" />
                            <Condition Binding="{Binding Visibility, ElementName=FrontExtensionBasePanel}" Value="Visible" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜前向墙+延长.png" />
                        <Setter Property="Tag" Value="柜前向墙+延长.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetFrontToWall" />
                            <Condition Binding="{Binding IsEnabled, ElementName=BackBaseParameterGroup}" Value="True" />
                            <Condition Binding="{Binding Visibility, ElementName=BackExtensionBasePanel}" Value="Visible" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜前向墙+延长.png" />
                        <Setter Property="Tag" Value="柜前向墙+延长.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetRearToWall" />
                            <Condition Binding="{Binding IsEnabled, ElementName=FrontBaseParameterGroup}" Value="True" />
                            <Condition Binding="{Binding Visibility, ElementName=FrontExtensionBasePanel}" Value="Visible" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜后向墙+延长.png" />
                        <Setter Property="Tag" Value="柜后向墙+延长.png" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=BaseParamTabItem}" Value="True" />
                            <Condition Binding="{Binding CabinetOrientation}" Value="CabinetRearToWall" />
                            <Condition Binding="{Binding IsEnabled, ElementName=BackBaseParameterGroup}" Value="True" />
                            <Condition Binding="{Binding Visibility, ElementName=BackExtensionBasePanel}" Value="Visible" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/柜后向墙+延长.png" />
                        <Setter Property="Tag" Value="柜后向墙+延长.png" />
                    </MultiDataTrigger>
                    <!-- 四个整体参数分类共用总览图，切换分类时不受其他页签焦点影响。 -->
                    <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=GeneralParametersPanel}" Value="GeneralParameters">
                        <Setter Property="Source" Value="pack://application:,,,/CKBusbarBridge;component/Images/示意图3.png" />
                        <Setter Property="Tag" Value="示意图3.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ParamSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#595959" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ParamHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#999999" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="96" />
            </Style>

            <Style x:Key="HoleParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="150" />
            </Style>

            <Style x:Key="RoundedInputBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="32" />
                <Setter Property="Width" Value="120" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ParamTextBoxStyle" TargetType="hc:TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="hc:InfoElement.Placeholder" Value="请输入参数值" />
                <EventSetter Event="GotKeyboardFocus" Handler="DimensionTextBox_GotKeyboardFocus" />
            </Style>

            <Style x:Key="ParamComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="MainBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          Margin="0,0,4,0"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                        <Path Grid.Column="1"
                                              Width="10"
                                              Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="#8C8C8C"
                                              Data="M 0 0 L 5 6 L 10 0 Z" />
                                    </Grid>
                                </Border>

                                <Popup x:Name="Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Background="White"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <ScrollViewer MaxHeight="240"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="#BFBFBF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="#1677FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VerticalSideTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource TabItemInLine}">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <Style x:Key="VerticalSideTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource TabControlInLine}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource VerticalSideTabItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid x:Name="templateRoot" Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition0" />
                                    <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                                    <RowDefinition x:Name="RowDefinition1" Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Rows="1"
                                             x:Name="headerPanel"
                                             VerticalAlignment="Top"
                                             KeyboardNavigation.TabNavigation="Once"
                                             KeyboardNavigation.DirectionalNavigation="Cycle"
                                             Background="Transparent"
                                             Grid.Column="0"
                                             IsItemsHost="True"
                                             Margin="0"
                                             Grid.Row="0" />
                                <Border x:Name="contentPanel"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{TemplateBinding Background}"
                                        Grid.Column="0"
                                        Grid.Row="1">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="0"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TabStripPlacement" Value="Bottom">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="Auto" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Left">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                                    <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto" />
                                    <Setter TargetName="ColumnDefinition1" Property="Width" Value="*" />
                                    <Setter TargetName="contentPanel" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Rows" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Columns" Value="1" />
                                    <Setter TargetName="headerPanel" Property="VerticalAlignment" Value="Top" />
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Right">
                                    <Setter TargetName="RowDefinition0" Property="Height" Value="Auto" />
                                    <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                                    <Setter TargetName="ColumnDefinition0" Property="Width" Value="*" />
                                    <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto" />
                                    <Setter TargetName="contentPanel" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="contentPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="headerPanel" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Rows" Value="0" />
                                    <Setter TargetName="headerPanel" Property="Columns" Value="1" />
                                    <Setter TargetName="headerPanel" Property="VerticalAlignment" Value="Top" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E6F4FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 图号信息属于柜体生成前置数据；新项目由会话暂存，生成时写入总装配体。 -->
            <Button x:Name="GenerateDrawingNumberButton" Grid.Column="0" Content="图号生成" Width="100" Height="28" Click="GenerateDrawingNumber_Click" />
            <TextBlock Grid.Column="2" Text="项目根目录" VerticalAlignment="Center" />
            <hc:TextBox x:Name="ProjectPathTextBox" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Text="{Binding ProjectPath, UpdateSourceTrigger=LostFocus}" />
            <Button x:Name="SelectProjectPathButton" Grid.Column="6" Content="设置项目根目录" Height="28" Padding="12,0" Command="{Binding SelectProjectPathCommand}" />
            <Border x:Name="CabinetScenarioBadge" Grid.Column="8"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="#E6F4FF"
                    BorderBrush="#91CAFF"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Text="{Binding ScenarioDisplayName}"
                           Foreground="#0958D9"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="GeneralParametersPanel" Grid.Column="0"
                        Style="{StaticResource VerticalSideTabControlStyle}"
                        TabStripPlacement="Left" SelectedIndex="0"
                        SelectionChanged="ParameterTabControl_SelectionChanged">
                <TabItem x:Name="BuildingInstallationParamTabItem" Header="建筑与安装" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="建筑与安装" Style="{StaticResource ParamSectionTitleStyle}" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="楼高(L)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                         <hc:TextBox x:Name="BuildingHeightTextBox" Tag="楼高(L)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入楼高" Text="{Binding Parameters.General.BuildingHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="地面距横梁(B)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                         <hc:TextBox x:Name="FloorToBeamDistanceTextBox" Tag="地面距横梁(B)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入地面距横梁距离" Text="{Binding Parameters.General.FloorToBeamDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="柜体离地(I)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <hc:TextBox x:Name="CabinetGroundHeightTextBox" Tag="柜体离地(I)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入柜体离地高度" Text="{Binding Parameters.General.CabinetGroundHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WallDistanceDisplayName}" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <hc:TextBox x:Name="CabinetToWallDistanceTextBox" Tag="{Binding WallDistanceDisplayName}" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入柜体距墙的距离" Text="{Binding Parameters.General.CabinetToWallDistance, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="墙孔边距地面(C)" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                         <hc:TextBox x:Name="WallHoleEdgeGroundHeightTextBox" Tag="墙孔边距地面(C)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入墙孔边距地面高度" Text="{Binding Parameters.General.WallHoleEdgeGroundHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="墙柜偏心值" Style="{StaticResource ParamLabelStyle}" Margin="0,10,8,0" />
                                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,10,0,0">
                                        <hc:TextBox x:Name="WallCabinetEccentricityTextBox" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入墙柜偏心值" Text="{Binding Parameters.General.WallCabinetEccentricity, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WallHoleParamTabItem" Header="墙孔参数" Tag="GeneralParameters">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="墙孔参数" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="墙孔高度(E)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                         <hc:TextBox x:Name="WallHoleHeightTextBox" Tag="墙孔高度(E)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入墙孔高度" Text="{Binding Parameters.General.WallHoleHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="墙孔宽度(G)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                         <hc:TextBox x:Name="WallHoleWidthTextBox" Tag="墙孔宽度(G)" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入墙孔宽度" Text="{Binding Parameters.General.WallHoleWidth, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="末端基架安装参数" Style="{StaticResource ParamSectionTitleStyle}" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                        <hc:TextBox x:Name="WallTopClearanceTextBox" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Parameters.General.WallInstallation.Top, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="下间距(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
