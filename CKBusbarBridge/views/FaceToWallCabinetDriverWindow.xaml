                                <Grid x:Name="FrontBaseParameterGroup" Margin="22,0,0,24" IsEnabled="{Binding IsChecked, ElementName=FrontHoleToggleButton}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
