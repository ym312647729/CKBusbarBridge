                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                        <rd:RDInput x:Name="FrontInsulatorPositionTextBox" Tag="绝缘子定位" Text="{Binding Parameters.Cabinet.FrontHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
