                                                    <hc:TextBox x:Name="BFrontHoleL1TextBox" Tag="柜前孔-L1" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入L1" Text="{Binding Parameters.BCabinet.FrontHole.L1, UpdateSourceTrigger=LostFocus}" />
