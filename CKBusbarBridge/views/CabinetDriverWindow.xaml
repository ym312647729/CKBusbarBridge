                                                    <hc:TextBox x:Name="BFrontBaseOpeningHeightTextBox" Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基架高度" Text="{Binding Parameters.BCabinet.FrontHole.BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
