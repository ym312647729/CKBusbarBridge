                                                    <hc:TextBox x:Name="BFrontBaseHeightTextBox" Tag="基座高" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基座高" Text="{Binding Parameters.BCabinet.FrontHole.BaseHeight, UpdateSourceTrigger=LostFocus}" TextChanged="BaseHeightTextBox_TextChanged" />
                                                </Border>

                                                <TextBlock x:Name="BFrontExtensionBaseHintTextBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="基座高超过1400将添加延长基座" Foreground="#D46B08" Margin="0,0,0,10" Visibility="Collapsed" />

                                                <StackPanel x:Name="BFrontExtensionBasePanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Visibility="Collapsed">
