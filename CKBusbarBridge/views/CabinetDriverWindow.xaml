                                        <StackPanel>
                                            <TextBlock Text="柜前孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <!-- 基座组始终显示；是否可编辑直接跟随对应柜孔开关，关闭时保留原值。 -->
                                            <Grid x:Name="BFrontBaseParameterGroup" Margin="22,0,0,24" IsEnabled="{Binding Parameters.BCabinet.FrontHole.IsEnabled}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BFrontInsulatorPositionTextBox" Tag="绝缘子定位" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入绝缘子定位" Text="{Binding Parameters.BCabinet.FrontHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
