<rd:RDWindow x:Class="CKBusbarBridge.views.CabinetDriverWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:rd="clr-namespace:RD.UI.Wpf.Controls;assembly=RD.UI.Wpf"
             xmlns:local="clr-namespace:CKBusbarBridge.views"
             xmlns:designUi="clr-namespace:CKBusbarBridge.views;assembly=CKBusbarBridge.DesignUI"
             mc:Ignorable="d"
        WindowKey="CabinetDriverWindow" UseLayoutRounding="True" IsPlacementPersistenceEnabled="False"
        Title="柜体驱动 - 面对面场景"
        Width="360" Height="700"
        MinWidth="320" MinHeight="320"
        WindowStartupLocation="Manual"
        PreviewKeyDown="InputTextBox_PreviewKeyDown"
        >

    <rd:RDWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RD.UI.Wpf;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="96" />
            </Style>

            <Style x:Key="HoleParamLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Width" Value="150" />
            </Style>

            <Style x:Key="RoundedInputBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

        </ResourceDictionary>
    </rd:RDWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding ScenarioDisplayName}" Style="{StaticResource RDText.H3}" Margin="0,0,0,12" />
            <TextBlock Text="项目根目录" Style="{StaticResource RDText.Caption}" Margin="0,0,0,4" />
            <rd:RDInput x:Name="ProjectPathTextBox"
                        Text="{Binding ProjectPath, UpdateSourceTrigger=LostFocus}" />
            <WrapPanel Margin="0,8,0,0">
                <rd:RDButton x:Name="SelectProjectPathButton" Content="选择项目目录"
                             Command="{Binding SelectProjectPathCommand}" Margin="0,0,8,8" />
                <rd:RDButton x:Name="GenerateDrawingNumberButton" Content="生成图号"
                             Click="GenerateDrawingNumber_Click" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">


            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="GeneralParametersPanel" Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="整体参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="楼高(D)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                    <rd:RDInput x:Name="FloorHeightTextBox" Tag="楼高(D)" Text="{Binding Parameters.General.FloorHeight, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="柜间距(A)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,0" />
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}">
                                    <rd:RDInput x:Name="CabinetSpacingTextBox" Tag="柜间距(A)" Text="{Binding Parameters.General.CabinetSpacing, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="B" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDInput x:Name="GeneralParameterBTextBox" Tag="B" Text="{Binding Parameters.General.ParameterB, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="柜间偏心值" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDInput x:Name="CabinetEccentricityTextBox" Text="{Binding Parameters.General.CabinetEccentricity, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="铜排规格" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDInput x:Name="BusbarSpecTextBox" Text="{Binding Parameters.General.BusbarSpec, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="相间距" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDInput x:Name="PhaseSpacingTextBox" Tag="相间距"  ToolTip="相间距至少为排宽＋绝缘距离" Text="{Binding Parameters.General.PhaseSpacing, UpdateSourceTrigger=LostFocus}" />
                                </Border>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="单相根数" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDComboBox x:Name="SinglePhaseRootCountComboBox"
                                              Height="30"



                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Parameters.General.SinglePhaseRootCount, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="1" Tag="1" />
                                        <ComboBoxItem Content="2" Tag="2" />
                                        <ComboBoxItem Content="3" Tag="3" />
                                        <ComboBoxItem Content="4" Tag="4" />
                                    </rd:RDComboBox>
                                </Border>

                                <TextBlock Grid.Row="3" Grid.Column="3" Text="铜排材质" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDComboBox x:Name="BusbarMaterialComboBox"
                                              Height="30"



                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              SelectedValuePath="Content"
                                              SelectedValue="{Binding Parameters.General.BusbarMaterial, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="直角铜母线" />
                                        <ComboBoxItem Content="全圆边铜母线" />
                                    </rd:RDComboBox>
                                </Border>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="A柜伸出排相序" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDComboBox x:Name="ACabinetExposedBusbarPhaseSequenceComboBox"
                                              Height="30"



                                              SelectedValuePath="Content"
                                              SelectedValue="{Binding Parameters.General.ACabinetExposedBusbarPhaseSequence, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="ABC" />
                                        <ComboBoxItem Content="CBA" />
                                    </rd:RDComboBox>
                                </Border>

                                <TextBlock Grid.Row="4" Grid.Column="3" Text="B柜伸出排相序" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDComboBox x:Name="BCabinetExposedBusbarPhaseSequenceComboBox"
                                              Height="30"



                                              SelectedValuePath="Content"
                                              SelectedValue="{Binding Parameters.General.BCabinetExposedBusbarPhaseSequence, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="ABC" />
                                        <ComboBoxItem Content="CBA" />
                                    </rd:RDComboBox>
                                </Border>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="绝缘子+支架高度" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource RoundedInputBorderStyle}">
                                        <rd:RDInput x:Name="InsulatorHeightTextBox" Text="{Binding Parameters.General.InsulatorHeight, UpdateSourceTrigger=LostFocus}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="（含支架高度：25）"
                                               ToolTip="支架高度为25 mm；输入总高不包含上方垫块。"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               Foreground="#999999"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="绝缘距离(mm)" Style="{StaticResource ParamLabelStyle}" Margin="0,12,8,0" />
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,12,0,0">
                                    <rd:RDInput x:Name="InsulationDistanceTextBox" Text="{Binding Parameters.General.InsulationDistance, UpdateSourceTrigger=LostFocus}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <rd:RDTabControl HeaderWrap="True"  SelectionChanged="ParameterTabControl_SelectionChanged">
                        <TabItem x:Name="ATabItem" Header="A柜参数">
                            <rd:RDTabControl HeaderWrap="True"  >
                                <TabItem x:Name="ACabinetParamTabItem" Header="柜体参数">
                                    <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="620">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="柜高" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <rd:RDInput x:Name="ACabinetHeightTextBox" Text="{Binding Parameters.ACabinet.CabinetHeight, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="柜深" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <rd:RDInput x:Name="ACabinetDepthTextBox" Tag="A-柜深" Text="{Binding Parameters.ACabinet.CabinetDepth, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="柜宽" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <rd:RDInput x:Name="ACabinetWidthTextBox" Text="{Binding Parameters.ACabinet.CabinetWidth, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="离地高度(I)" Style="{StaticResource ParamLabelStyle}" Margin="0,0,8,10" />
                                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                <rd:RDInput x:Name="ATextBoxI" Text="{Binding Parameters.ACabinet.GroundHeight, UpdateSourceTrigger=LostFocus}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </TabItem>

                                <TabItem x:Name="AHoleParamTabItem" Header="柜顶开孔参数">
                                    <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="620">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="柜前孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="AFrontHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.ACabinet.FrontHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
                                            </Grid>

                                            <Grid Margin="22,0,0,24" IsEnabled="{Binding IsChecked, ElementName=AFrontHoleToggleButton}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="距柜前距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontHoleToFrontDistanceTextBox" Tag="柜前孔-距柜前距离" Text="{Binding Parameters.ACabinet.FrontHole.ToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="铜排中心至柜前距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontHoleBusbarCenterToFrontDistanceTextBox" Tag="柜前孔-铜排中心至柜前距离" Text="{Binding Parameters.ACabinet.FrontHole.BusbarCenterToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="接口固定孔间距：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontHoleFixedHoleSpacingTextBox" Tag="柜前孔-接口固定孔间距" Text="{Binding Parameters.ACabinet.FrontHole.FixedHoleSpacing, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontHoleL1TextBox" Tag="柜前孔-L1" Text="{Binding Parameters.ACabinet.FrontHole.L1, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontHoleL2TextBox" Tag="柜前孔-L2" Text="{Binding Parameters.ACabinet.FrontHole.L2, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                                    <rd:RDInput x:Name="AFrontHoleL3TextBox" Tag="柜前孔-L3" Text="{Binding Parameters.ACabinet.FrontHole.L3, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                            </Grid>

                                            <Grid Margin="0,0,0,12" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="柜后孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="ABackHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.ACabinet.BackHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
                                            </Grid>

                                            <Grid Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ABackHoleToggleButton}" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="距柜后距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="ABackHoleToBackDistanceTextBox" Tag="柜后孔-距柜后距离" Text="{Binding Parameters.ACabinet.BackHole.ToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="铜排中心至柜后距离：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="ABackHoleBusbarCenterToBackDistanceTextBox" Tag="柜后孔-铜排中心至柜后距离" Text="{Binding Parameters.ACabinet.BackHole.BusbarCenterToCabinetEdgeDistance, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="接口固定孔间距：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="ABackHoleFixedHoleSpacingTextBox" Tag="柜后孔-接口固定孔间距" Text="{Binding Parameters.ACabinet.BackHole.FixedHoleSpacing, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="L1：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="ABackHoleL1TextBox" Tag="柜后孔-L1" Text="{Binding Parameters.ACabinet.BackHole.L1, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="L2：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="ABackHoleL2TextBox" Tag="柜后孔-L2" Text="{Binding Parameters.ACabinet.BackHole.L2, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="L3：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,0" />
                                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}">
                                                    <rd:RDInput x:Name="ABackHoleL3TextBox" Tag="柜后孔-L3" Text="{Binding Parameters.ACabinet.BackHole.L3, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem x:Name="ABaseParamTabItem" Header="基座参数">
                                    <Border Padding="16" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="620">
                                        <StackPanel>
                                            <TextBlock Text="柜前孔基座" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <!-- 基座组始终显示；是否可编辑直接跟随对应柜孔开关，关闭时保留原值。 -->
                                            <Grid x:Name="AFrontBaseParameterGroup" Margin="22,0,0,24" IsEnabled="{Binding Parameters.ACabinet.FrontHole.IsEnabled}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontInsulatorPositionTextBox" Tag="绝缘子定位" Text="{Binding Parameters.ACabinet.FrontHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontBaseOpeningHeightTextBox" Tag="基架高度" Text="{Binding Parameters.ACabinet.FrontHole.BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <rd:RDInput x:Name="AFrontBaseHeightTextBox" Tag="基座高" Text="{Binding Parameters.ACabinet.FrontHole.BaseHeight, UpdateSourceTrigger=LostFocus}" TextChanged="BaseHeightTextBox_TextChanged" />
                                                </Border>

                                                <TextBlock x:Name="AFrontExtensionBaseHintTextBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="基座高超过1400将添加延长基座" Foreground="#D46B08" Margin="0,0,0,10" Visibility="Collapsed" />

                                                <StackPanel x:Name="AFrontExtensionBasePanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal">
