                                                <TextBlock Grid.Column="0" Text="柜后孔" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="BBackHoleToggleButton" Grid.Column="2" IsChecked="{Binding Parameters.BCabinet.BackHole.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" Style="{StaticResource ToggleButtonSwitch}" />
