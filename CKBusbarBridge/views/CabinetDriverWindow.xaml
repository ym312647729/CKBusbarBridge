                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Padding="12" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                <Grid ClipToBounds="True">
                    <Image x:Name="PreviewImage"
                           Style="{StaticResource PreviewImageStyle}"
                           SizeChanged="PreviewImage_SizeChanged" />
                    <Canvas x:Name="DimensionHighlightCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Rectangle Stroke="#FFFF0000"
                                   StrokeThickness="1.5"
                                   Fill="#20FF0000"
                                   Canvas.Left="{Binding DimensionHighlightLeft}"
                                   Canvas.Top="{Binding DimensionHighlightTop}"
                                   Width="{Binding DimensionHighlightWidth}"
                                   Height="{Binding DimensionHighlightHeight}"
                                   SnapsToDevicePixels="True">
                            <Rectangle.Visibility>
                                <MultiBinding Converter="{StaticResource DimensionHighlightVisibilityConverter}">
                                    <Binding Path="DimensionHighlightVisibility" />
                                    <Binding Path="Tag" ElementName="PreviewImage" />
                                    <Binding Path="ActiveDimensionImageName" />
                                </MultiBinding>
                            </Rectangle.Visibility>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="GenerateButton" Content="生成" Width="100" Height="32" Margin="0,0,32,0" Visibility="{Binding GenerateButtonVisibility}" Style="{StaticResource ButtonPrimary}" Command="{Binding GenerateCommand}" />
        </StackPanel>

    </Grid>
</Window>
