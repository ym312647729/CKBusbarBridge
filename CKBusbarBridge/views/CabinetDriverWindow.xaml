                                                        <Border Style="{StaticResource RoundedInputBorderStyle}">
                                                            <hc:TextBox x:Name="BBackExtensionBaseTextBox" Tag="延长基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Parameters.BCabinet.BackHole.ExtensionBaseHeight, UpdateSourceTrigger=LostFocus}" hc:InfoElement.Placeholder="请输入延长基座高" TextChanged="ExtensionBaseTextBox_TextChanged" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="BBackBasicBaseHeightTextBlock" Margin="158,4,0,0" FontSize="12" Foreground="#999999" />
