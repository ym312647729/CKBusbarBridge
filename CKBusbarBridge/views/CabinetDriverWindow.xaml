                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="绝缘子定位：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackInsulatorPositionTextBox" Tag="绝缘子定位" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入绝缘子定位" Text="{Binding Parameters.BCabinet.BackHole.InsulatorPosition, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="基架高度：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackBaseOpeningHeightTextBox" Tag="基架高度" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基架高度" Text="{Binding Parameters.BCabinet.BackHole.BaseOpeningHeight, UpdateSourceTrigger=LostFocus}" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="基座高：" Style="{StaticResource HoleParamLabelStyle}" Margin="0,0,8,10" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedInputBorderStyle}" Margin="0,0,0,10">
                                                    <hc:TextBox x:Name="BBackBaseHeightTextBox" Tag="基座高" Style="{StaticResource ParamTextBoxStyle}" hc:InfoElement.Placeholder="请输入基座高" Text="{Binding Parameters.BCabinet.BackHole.BaseHeight, UpdateSourceTrigger=LostFocus}" TextChanged="BaseHeightTextBox_TextChanged" />
                                                </Border>

                                                <TextBlock x:Name="BBackExtensionBaseHintTextBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="基座高超过1400将添加延长基座" Foreground="#D46B08" Margin="0,0,0,10" Visibility="Collapsed" />

