                                                            <hc:TextBox x:Name="BFrontExtensionBaseTextBox" Tag="延长基座高" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Parameters.BCabinet.FrontHole.ExtensionBaseHeight, UpdateSourceTrigger=LostFocus}" hc:InfoElement.Placeholder="请输入延长基座高" TextChanged="ExtensionBaseTextBox_TextChanged" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="BFrontBasicBaseHeightTextBlock" Margin="158,4,0,0" FontSize="12" Foreground="#999999" />
                                                </StackPanel>
                                            </Grid>

